{
  "name": "aventura-do-sparky-2",
  "main": "worker.ts",
  "workers_dev": true,
  "keep_vars": true,
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  }
}